{
  "log": {
    "loglevel": "info"
  },
  "dns": {
    "servers": [
      {
        "address": "tls://dns.quad9.net",
        "domains": [
          "all"
        ]
      }
    ]
  },
  "inbounds": [
    {
      "tag": "internetKafeXDNS",
      "port": 13868,
      "listen": "0.0.0.0",
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "none",
        "encryption": "none"
      },
      "sniffing": {
        "enabled": false,
        "routeOnly": false,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "metadataOnly": false
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "finalmask": {
          "udp": [
            {
              "type": "xdns",
              "settings": {
                "domain": "77.88.8.8"
              }
            }
          ]
        },
        "tcpSettings": {
          "header": {
            "type": "none"
          },
          "acceptProxyProtocol": false
        },
        "realitySettings": {
          "show": false,
          "xver": 0,
          "target": "amd.com:443",
          "shortIds": [
            "e852dc",
            "ead36c6a1806",
            "7e18",
            "43309443e8",
            "2b",
            "0a31a96b3408cd",
            "2f65ac8df70e2238",
            "9187a05e"
          ],
          "privateKey": "yourprivatekey",
          "maxTimediff": 0,
          "mldsa65Seed": "",
          "serverNames": [
            "amd.com"
          ],
          "maxClientVer": "",
          "minClientVer": ""
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIPv4"
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "rules": [
      {
        "type": "field",
        "protocol": [
          "bittorrent"
        ],
        "outboundTag": "block"
      }
    ],
    "domainStrategy": "IPIfNonMatch"
  },
  "policy": {
    "levels": {
      "0": {
        "connIdle": 300,
        "handshake": 4,
        "bufferSize": 512,
        "uplinkOnly": 5,
        "downlinkOnly": 30
      }
    },
    "system": {
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  }
}
